#!/usr/bin/env bash
# Lanza MKSCRIPT Studio directamente desde el repositorio, sin pip ni entorno virtual.
# Uso:
#   ./mkscript-studio [archivo.sh]   Abre la aplicación (y opcionalmente un script)
#   ./mkscript-studio --install-deps Instala las dependencias del sistema (pide sudo)
#   ./mkscript-studio --check        Solo comprueba las dependencias

set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
readonly ROOT
readonly PYTHON="${PYTHON:-python3}"

info() { printf '[*] %s\n' "$*" >&2; }
die()  { printf '[X] %s\n' "$*" >&2; exit 1; }

deps_command() {
    if command -v apt-get >/dev/null 2>&1; then
        echo "sudo apt-get install -y python3 python3-gi gir1.2-gtk-4.0 gir1.2-adw-1 gir1.2-gtksource-5 shellcheck"
    elif command -v dnf >/dev/null 2>&1; then
        echo "sudo dnf install -y python3 python3-gobject gtk4 libadwaita gtksourceview5 ShellCheck"
    elif command -v pacman >/dev/null 2>&1; then
        echo "sudo pacman -S --needed python python-gobject gtk4 libadwaita gtksourceview5 shellcheck"
    fi
}

# Devuelve 0 si todo está listo, 1 si falta algo y 2 si hay versiones demasiado antiguas
# (en ese caso deja el detalle en VERSION_PROBLEM).
VERSION_PROBLEM=""
check_deps() {
    command -v "${PYTHON}" >/dev/null 2>&1 || return 1
    local status=0
    VERSION_PROBLEM="$("${PYTHON}" - 2>/dev/null <<'EOF'
import sys
if sys.version_info < (3, 11):
    print(f"Python {sys.version_info.major}.{sys.version_info.minor} (se necesita 3.11 o posterior)")
    raise SystemExit(2)
try:
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    gi.require_version("GtkSource", "5")
    from gi.repository import Adw, Gtk, GtkSource  # noqa: F401
except (ImportError, ValueError):
    raise SystemExit(1)
problems = []
if (Gtk.get_major_version(), Gtk.get_minor_version()) < (4, 10):
    problems.append(f"GTK {Gtk.get_major_version()}.{Gtk.get_minor_version()} (se necesita 4.10 o posterior)")
if Adw.get_minor_version() < 4:
    problems.append(f"libadwaita 1.{Adw.get_minor_version()} (se necesita 1.4 o posterior)")
if problems:
    print("; ".join(problems))
    raise SystemExit(2)
EOF
)" || status=$?
    return "${status}"
}

too_old() {
    printf '[X] Tu sistema tiene versiones demasiado antiguas: %s\n' "${VERSION_PROBLEM}" >&2
    printf '    MKSCRIPT Studio necesita una distribución reciente (Debian 13, Ubuntu 24.04, Fedora 39,\n' >&2
    printf '    Kali o Arch actualizados). Actualizar paquetes no basta si la distribución es antigua.\n' >&2
    exit 1
}

# Comprueba las dependencias; con versiones antiguas termina con un mensaje claro.
deps_status() {
    local status=0
    check_deps || status=$?
    [[ "${status}" -ne 2 ]] || too_old
    return "${status}"
}

install_deps() {
    local cmd
    cmd="$(deps_command)"
    [[ -n "${cmd}" ]] || die "Distribución no reconocida; instala a mano: Python 3.11+, PyGObject, GTK 4, libadwaita y GtkSourceView 5"
    info "Se ejecutará: ${cmd}"
    if command -v apt-get >/dev/null 2>&1; then
        sudo apt-get update
    fi
    ${cmd}
}

case "${1:-}" in
    --install-deps)
        install_deps
        deps_status || die "Siguen faltando dependencias"
        info "Dependencias listas. Ejecuta ./mkscript-studio"
        exit 0
        ;;
    --check)
        deps_status || die "Faltan dependencias. Ejecuta: ./mkscript-studio --install-deps"
        info "Todas las dependencias están instaladas"
        exit 0
        ;;
esac

if ! deps_status; then
    printf '[X] Faltan dependencias del sistema (Python 3.11+, GTK 4, libadwaita o GtkSourceView 5).\n' >&2
    printf '    Instálalas con:  ./mkscript-studio --install-deps\n' >&2
    if cmd="$(deps_command)" && [[ -n "${cmd}" ]]; then
        printf '    (equivale a:     %s)\n' "${cmd}" >&2
    fi
    exit 1
fi

export PYTHONPATH="${ROOT}/src${PYTHONPATH:+:${PYTHONPATH}}"
exec "${PYTHON}" -m mkscript_studio "$@"
