#!/usr/bin/env bash
# Launches MKSCRIPT Studio straight from the repository, without pip or a virtualenv.
# Usage:
#   ./mkscript-studio [file.sh]      Open the application (and optionally a script)
#   ./mkscript-studio --install-deps Install the system dependencies (asks for sudo)
#   ./mkscript-studio --check        Only check the dependencies

set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
readonly ROOT
readonly PYTHON="${PYTHON:-python3}"

info() { printf '[*] %s\n' "$*" >&2; }
die()  { printf '[X] %s\n' "$*" >&2; exit 1; }

deps_command() {
    if command -v apt-get >/dev/null 2>&1; then
        echo "sudo apt-get install -y python3 python3-gi gir1.2-gtk-4.0 gir1.2-adw-1 gir1.2-gtksource-5 shellcheck"
    elif command -v dnf >/dev/null 2>&1; then
        echo "sudo dnf install -y python3 python3-gobject gtk4 libadwaita gtksourceview5 ShellCheck"
    elif command -v pacman >/dev/null 2>&1; then
        echo "sudo pacman -S --needed python python-gobject gtk4 libadwaita gtksourceview5 shellcheck"
    fi
}

# Returns 0 if everything is ready, 1 if something is missing and 2 if versions are
# too old (the details are left in VERSION_PROBLEM).
VERSION_PROBLEM=""
check_deps() {
    command -v "${PYTHON}" >/dev/null 2>&1 || return 1
    local status=0
    VERSION_PROBLEM="$("${PYTHON}" - 2>/dev/null <<'EOF'
import sys
if sys.version_info < (3, 11):
    print(f"Python {sys.version_info.major}.{sys.version_info.minor} (3.11 or later is required)")
    raise SystemExit(2)
try:
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    gi.require_version("GtkSource", "5")
    from gi.repository import Adw, Gtk, GtkSource  # noqa: F401
except (ImportError, ValueError):
    raise SystemExit(1)
problems = []
if (Gtk.get_major_version(), Gtk.get_minor_version()) < (4, 10):
    problems.append(f"GTK {Gtk.get_major_version()}.{Gtk.get_minor_version()} (4.10 or later is required)")
if Adw.get_minor_version() < 4:
    problems.append(f"libadwaita 1.{Adw.get_minor_version()} (1.4 or later is required)")
if problems:
    print("; ".join(problems))
    raise SystemExit(2)
EOF
)" || status=$?
    return "${status}"
}

too_old() {
    printf '[X] Your system has versions that are too old: %s\n' "${VERSION_PROBLEM}" >&2
    printf '    MKSCRIPT Studio needs a recent distribution (Debian 13, Ubuntu 24.04, Fedora 39,\n' >&2
    printf '    or an up-to-date Kali or Arch). Updating packages is not enough on an older release.\n' >&2
    exit 1
}

# Checks the dependencies; exits with a clear message when versions are too old.
deps_status() {
    local status=0
    check_deps || status=$?
    [[ "${status}" -ne 2 ]] || too_old
    return "${status}"
}

install_deps() {
    local cmd
    cmd="$(deps_command)"
    [[ -n "${cmd}" ]] || die "Unknown distribution; install manually: Python 3.11+, PyGObject, GTK 4, libadwaita and GtkSourceView 5"
    info "Will run: ${cmd}"
    if command -v apt-get >/dev/null 2>&1; then
        sudo apt-get update
    fi
    ${cmd}
}

case "${1:-}" in
    --install-deps)
        install_deps
        deps_status || die "Some dependencies are still missing"
        info "Dependencies ready. Run ./mkscript-studio"
        exit 0
        ;;
    --check)
        deps_status || die "Missing dependencies. Run: ./mkscript-studio --install-deps"
        info "All dependencies are installed"
        exit 0
        ;;
esac

if ! deps_status; then
    printf '[X] Missing system dependencies (Python 3.11+, GTK 4, libadwaita or GtkSourceView 5).\n' >&2
    printf '    Install them with:  ./mkscript-studio --install-deps\n' >&2
    if cmd="$(deps_command)" && [[ -n "${cmd}" ]]; then
        printf '    (equivalent to:     %s)\n' "${cmd}" >&2
    fi
    exit 1
fi

export PYTHONPATH="${ROOT}/src${PYTHONPATH:+:${PYTHONPATH}}"
exec "${PYTHON}" -m mkscript_studio "$@"
