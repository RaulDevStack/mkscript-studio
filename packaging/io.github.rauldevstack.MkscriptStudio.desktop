[Desktop Entry]
Type=Application
Name=MKSCRIPT Studio
GenericName=Editor de scripts Bash
Comment=Crea, edita, valida y guarda scripts Bash
Exec=mkscript-studio %f
Icon=io.github.rauldevstack.MkscriptStudio
Terminal=false
Categories=Development;IDE;GTK;
Keywords=bash;shell;script;editor;plantillas;
MimeType=application/x-shellscript;text/x-sh;
StartupNotify=true
